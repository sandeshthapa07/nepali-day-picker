{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "nepali-day-picker/react": ["./src/react/index.tsx"],
      "cn": ["./test/fixtures/stubs/cn.ts"],
      "lucide-react": ["./test/fixtures/stubs/lucide-react.tsx"],
      "@/registry/new-york-v4/ui/button": ["./test/fixtures/stubs/button.tsx"]
    }
  },
  "include": ["src", "test", "scripts", "*.config.ts"]
}
