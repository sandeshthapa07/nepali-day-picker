{
  "name": "nepali-day-picker",
  "version": "0.2.0",
  "description": "Bikram Sambat (BS, Nepali) <-> Gregorian (AD) date conversion, formatting, parsing and Nepal fiscal-year helpers, plus a BS calendar for react-day-picker and shadcn/ui.",
  "keywords": [
    "nepali",
    "nepal",
    "bikram-sambat",
    "bs",
    "vikram-samvat",
    "nepali-date",
    "date-converter",
    "calendar",
    "fiscal-year",
    "devanagari",
    "react-day-picker",
    "shadcn",
    "nepali-calendar",
    "date-picker",
    "react"
  ],
  "homepage": "https://github.com/sandeshthapa07/nepali-day-picker#readme",
  "bugs": {
    "url": "https://github.com/sandeshthapa07/nepali-day-picker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeshthapa07/nepali-day-picker.git"
  },
  "license": "MIT",
  "author": "Sandesh Thapa",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./date-lib": {
      "import": {
        "types": "./dist/date-lib.d.ts",
        "default": "./dist/date-lib.js"
      },
      "require": {
        "types": "./dist/date-lib.d.cts",
        "default": "./dist/date-lib.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data/bs-calendar.json",
    "data/SOURCES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-day-picker": "^9.7.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "node scripts/test-tz.mjs",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "size": "npm run build && size-limit",
    "data": "node scripts/build-data.mjs",
    "data:check": "node scripts/build-data.mjs --check",
    "check": "npm run data:check && npm run typecheck && npm run lint && npm run test:tz && npm run test:rdp && npm run size",
    "prepublishOnly": "npm run check",
    "test:rdp": "node scripts/test-rdp.mjs"
  },
  "size-limit": [
    {
      "name": "core: everything",
      "path": "dist/index.js",
      "limit": "6 kB"
    },
    {
      "name": "core: adToBs + bsToAd",
      "path": "dist/index.js",
      "import": "{ adToBs, bsToAd }",
      "limit": "2 kB"
    },
    {
      "name": "date-lib: createBsDateLib (react-day-picker not counted)",
      "path": "dist/date-lib.js",
      "import": "{ createBsDateLib }",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "react-day-picker"
      ],
      "limit": "4.5 kB"
    },
    {
      "name": "react: DayPicker (react and react-day-picker not counted)",
      "path": "dist/react.js",
      "import": "{ DayPicker }",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "react-day-picker"
      ],
      "limit": "6 kB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-day-picker-v10": "npm:react-day-picker@^10.0.2",
    "react-day-picker-v9-7": "npm:react-day-picker@^9.7.0",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
